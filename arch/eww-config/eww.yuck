; ── macOS Tahoe-inspired Eww Dock ────────────

; ── Variables ─────────────────────────────────
(defpoll current-time :interval "30s"
  "date '+%H:%M'")

; ── Widgets ───────────────────────────────────
(defwidget dock-item [icon command]
  (button
    :class "dock-button"
    :onclick command
    (box :class "dock-item" :orientation "v" :spacing 4 :space-evenly false
      (label :class "dock-icon" :text icon)
      (label :class "dock-dot" :text "•"))))

(defwidget dock-clock []
  (box :class "dock-clock" :orientation "v" :spacing 2 :space-evenly false
    (label :class "dock-clock-time" :text current-time)
    (label :class "dock-clock-label" :text "Lock")))

(defwidget app-dock []
  (centerbox :class "dock-shell"
    :orientation "h"
    (box :class "dock-left" :orientation "h" :spacing 10
      (dock-item :icon "󰀻" :command "wofi --show drun")
      (dock-item :icon "󰆍" :command "kitty")
      (dock-item :icon "󰈹" :command "thunar")
      (dock-item :icon "󰖟" :command "pavucontrol")
      (dock-item :icon "󰂯" :command "blueman-manager"))
    (box :class "dock-divider")
    (box :class "dock-right" :orientation "h" :spacing 10
      (dock-item :icon "󰇚" :command "~/.config/hypr/scripts/keybinds.sh")
      (dock-item :icon "󰖔" :command "~/.config/hypr/scripts/darkmode-toggle.sh")
      (button :class "dock-clock-button" :onclick "hyprlock" (dock-clock))
      (dock-item :icon "󰐥" :command "~/.config/hypr/scripts/powermenu.sh"))))

; ── Windows ───────────────────────────────────
(defwindow app-dock
  :monitor 0
  :geometry (geometry :x "0px"
                      :y "18px"
                      :width "760px"
                      :anchor "bottom center")
  :stacking "fg"
  :exclusive false
  :focusable false
  (app-dock))
