# ── macOS Tahoe-inspired Notifications

[global]
    monitor = 0
    follow = mouse
    width = 360
    height = 128
    origin = top-right
    offset = 16x16
    notification_limit = 4
    progress_bar = true

    indicate_hidden = yes
    transparency = 0
    separator_height = 0
    padding = 16
    horizontal_padding = 18
    text_icon_padding = 14

    frame_width = 1
    frame_color = "#DDE7F233"
    separator_color = frame

    sort = yes
    idle_threshold = 120

    font = JetBrainsMono Nerd Font 10
    line_height = 3
    markup = full
    format = "<b>%s</b>\n<span size='small'>%b</span>"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60

    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    icon_position = left
    min_icon_size = 32
    max_icon_size = 48

    corner_radius = 20

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1A2232DD"
    foreground = "#F6F7FB"
    highlight = "#8EDBE8"
    frame_color = "#F0F6FF2A"
    timeout = 4

[urgency_normal]
    background = "#1A2232DD"
    foreground = "#F6F7FB"
    highlight = "#8EDBE8"
    frame_color = "#F0F6FF2A"
    timeout = 8

[urgency_critical]
    background = "#2B2030EE"
    foreground = "#F6F7FB"
    highlight = "#FF9EB6"
    frame_color = "#FF9EB655"
    timeout = 0
