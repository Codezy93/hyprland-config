# ── Input Configuration ──────────────────────────
# Use `swaymsg -t get_inputs` to list available inputs

input type:keyboard {
    xkb_layout us
    repeat_delay 300
    repeat_rate 50
}

input type:touchpad {
    natural_scroll enabled
    tap enabled
    drag_lock enabled
    dwt enabled
}

input type:pointer {
    accel_profile flat
}
